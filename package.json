{
  "name": "scratch-box",
  "version": "0.0.10",
  "description": "Web component wrapper around custom animated checkbox (from codepen)",
  "main": "root.mjs",
  "module": "root.mjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "build-manifest": "node doc.mjs > custom-elements.json",
    "update": "ncu -u && npm install",
    "build": "powershell -command \"node build.mjs | out-file  -encoding  oem root.html\"",
    "safari": "npx playwright wk http://localhost:8000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/scratch-box.git"
  },
  "dependencies": {
    "be-bound": "0.0.38",
    "be-enhanced": "0.0.189",
    "be-hive": "0.0.267",
    "be-importing": "0.0.101",
    "blow-dry": "0.0.14",
    "mount-observer": "0.0.105",
    "soak-up": "0.0.3",
    "trans-render": "0.0.960",
    "xtal-element": "0.0.635"
  },
  "devDependencies": {
    "wc-info": "0.0.171",
    "spa-ssi": "0.0.23",
    "@playwright/test": "1.55.1"
  },
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/scratch-box/issues"
  },
  "homepage": "https://github.com/bahrus/scratch-box#readme"
}
