{
  "name": "scratch-box",
  "version": "0.0.14",
  "description": "Web component wrapper around custom animated checkbox (from codepen)",
  "main": "root.mjs",
  "module": "root.mjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "build-manifest": "node doc.mjs > custom-elements.json",
    "update": "ncu -u && npm install",
    "build-vscode-data": "node node_modules/cem-to-vscode-data/cemToVsCodeData.js custom-elements.json vscode.html-custom-data.json",
    "build-webtypes": "node node_modules/cem-to-web-types-converter/CEMToWebTypesConverter.js custom-elements.json web-types.json",
    "build-html": "powershell -command \"node build.mjs | out-file  -encoding  oem root.html\"",
    "build-features": "node --watch features.mjs",
    "build": "npm run build-html && npm run build-manifest && npm run build-webtypes && npm run build-vscode-data",
    "safari": "npx playwright wk http://localhost:8000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/scratch-box.git"
  },
  "dependencies": {
    "assign-gingerly": "0.0.75",
    "be-bound": "0.0.42",
    "be-hive": "0.1.16",
    "el-maker": "0.0.7",
    "font-face-feature": "0.0.6",
    "imp-h": "0.0.5",
    "mount-observer": "0.1.47",
    "templ-maker": "0.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "be-gone": "0.0.5",
    "cem-to-web-types-converter": "0.0.2",
    "cem-to-vscode-data": "0.0.2",
    "nested-regex-groups": "0.0.8",
    "soak-up": "0.0.9",
    "spa-ssi": "0.0.27",
    "wc-info": "0.0.185"
  },
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/scratch-box/issues"
  },
  "homepage": "https://github.com/bahrus/scratch-box#readme"
}
